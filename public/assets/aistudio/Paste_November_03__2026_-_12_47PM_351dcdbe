<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Programa de Mantenimiento Integral | Inyección, Soplado y Auxiliares</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0b0f19; --bg-card: #151c2c; --bg-card-hover: #1e293b;
            --accent-cyan: #06b6d4; --accent-amber: #f59e0b; --accent-emerald: #10b981;
            --accent-red: #ef4444; --accent-purple: #a855f7; --accent-blue: #3b82f6;
            --text-primary: #f1f5f9; --text-secondary: #94a3b8; --border-color: #2d3748;
            --shadow-glow: 0 0 20px rgba(6, 182, 212, 0.15);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            background-color: var(--bg-dark); color: var(--text-primary);
            font-family: 'Inter', sans-serif; line-height: 1.6;
            min-height: 100vh; overflow-y: auto; overflow-x: hidden; word-wrap: break-word;
        }

        .app-header {
            background: rgba(11, 15, 25, 0.95); backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color); padding: 1rem 2rem;
            position: sticky; top: 0; z-index: 100;
            display: flex; justify-content: space-between; align-items: center;
            flex-wrap: wrap; gap: 1rem;
        }

        .logo-area { display: flex; align-items: center; gap: 12px; }
        .logo-icon {
            width: 45px; height: 45px; background: linear-gradient(135deg, var(--accent-cyan), var(--accent-emerald));
            border-radius: 12px; display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem; color: #fff; box-shadow: var(--shadow-glow);
        }
        .logo-text h1 { font-size: 1.1rem; font-weight: 700; letter-spacing: 0.5px; }
        .logo-text span { font-size: 0.7rem; color: var(--accent-cyan); font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }

        .nav-tabs {
            display: flex; gap: 4px; background: var(--bg-card);
            padding: 6px; border-radius: 12px; border: 1px solid var(--border-color);
            overflow-x: auto; max-width: 100%; flex-wrap: wrap;
        }
        .nav-btn {
            background: transparent; border: none; color: var(--text-secondary);
            padding: 0.5rem 0.9rem; border-radius: 8px; cursor: pointer;
            font-size: 0.8rem; font-weight: 600; transition: all 0.2s;
            white-space: nowrap; display: flex; align-items: center; gap: 6px;
        }
        .nav-btn i { font-size: 0.95rem; }
        .nav-btn:hover { color: var(--text-primary); background: var(--bg-card-hover); }
        .nav-btn.active { background: var(--accent-cyan); color: #0b0f19; font-weight: 700; }

        .main-container { max-width: 1400px; margin: 0 auto; padding: 2rem; padding-bottom: 5rem; width: 100%; }
        .tab-content { display: none; animation: fadeIn 0.3s ease; width: 100%; }
        .tab-content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem; }
        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
        .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }

        .card {
            background: var(--bg-card); border: 1px solid var(--border-color);
            border-radius: 16px; padding: 1.5rem; transition: all 0.2s;
            height: auto; overflow: visible; min-width: 0;
        }
        .card:hover { border-color: var(--accent-cyan); box-shadow: var(--shadow-glow); }

        .card-header {
            display: flex; align-items: center; gap: 12px;
            margin-bottom: 1.25rem; padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--border-color); flex-wrap: wrap;
        }
        .card-header i { font-size: 1.5rem; color: var(--accent-cyan); width: 32px; text-align: center; }
        .card-header h2 { font-size: 1.1rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; word-break: break-word; }
        .card-header.amber i { color: var(--accent-amber); }
        .card-header.emerald i { color: var(--accent-emerald); }
        .card-header.red i { color: var(--accent-red); }
        .card-header.purple i { color: var(--accent-purple); }
        .card-header.blue i { color: var(--accent-blue); }

        .table-wrapper {
            width: 100%; max-width: 100%; overflow-x: auto; overflow-y: hidden;
            border-radius: 8px; border: 1px solid rgba(45, 55, 72, 0.4); margin-bottom: 1rem;
        }

        .tech-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; min-width: 600px; }
        .tech-table th {
            text-align: left; padding: 0.75rem 0.5rem; background: rgba(255,255,255,0.03);
            color: var(--accent-cyan); font-weight: 600; text-transform: uppercase;
            font-size: 0.75rem; letter-spacing: 0.5px; border-bottom: 1px solid var(--border-color);
        }
        .tech-table td { padding: 0.75rem 0.5rem; border-bottom: 1px solid rgba(45, 55, 72, 0.4); color: var(--text-secondary); vertical-align: top; }
        .tech-table tr:hover td { background: rgba(255,255,255,0.02); color: var(--text-primary); }

        .badge { display: inline-block; padding: 0.25rem 0.6rem; border-radius: 6px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; }
        .badge-cyan { background: rgba(6, 182, 212, 0.15); color: var(--accent-cyan); border: 1px solid rgba(6, 182, 212, 0.3); }
        .badge-amber { background: rgba(245, 158, 11, 0.15); color: var(--accent-amber); border: 1px solid rgba(245, 158, 11, 0.3); }
        .badge-emerald { background: rgba(16, 185, 129, 0.15); color: var(--accent-emerald); border: 1px solid rgba(16, 185, 129, 0.3); }
        .badge-red { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); border: 1px solid rgba(239, 68, 68, 0.3); }
        .badge-purple { background: rgba(168, 85, 247, 0.15); color: var(--accent-purple); border: 1px solid rgba(168, 85, 247, 0.3); }
        .badge-blue { background: rgba(59, 130, 246, 0.15); color: var(--accent-blue); border: 1px solid rgba(59, 130, 246, 0.3); }

        .alert-box { padding: 1rem; border-radius: 10px; margin-bottom: 1rem; font-size: 0.85rem; border-left: 4px solid; }
        .alert-box.warning { background: rgba(245, 158, 11, 0.08); border-color: var(--accent-amber); }
        .alert-box.danger { background: rgba(239, 68, 68, 0.08); border-color: var(--accent-red); }
        .alert-box.info { background: rgba(6, 182, 212, 0.08); border-color: var(--accent-cyan); }
        .alert-box.success { background: rgba(16, 185, 129, 0.08); border-color: var(--accent-emerald); }
        .alert-box strong { display: block; margin-bottom: 0.25rem; font-size: 0.9rem; }

        .kpi-card {
            background: linear-gradient(145deg, var(--bg-card), var(--bg-dark));
            border: 1px solid var(--border-color); border-radius: 12px;
            padding: 1.5rem; text-align: center; position: relative; overflow: hidden;
        }
        .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: var(--accent-cyan); }
        .kpi-card.emerald::before { background: var(--accent-emerald); }
        .kpi-card.amber::before { background: var(--accent-amber); }
        .kpi-card.red::before { background: var(--accent-red); }
        .kpi-value { font-size: 2rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.2rem; }
        .kpi-label { font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 1px; }

        .accordion { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; margin-bottom: 1rem; overflow: hidden; }
        .accordion-header {
            padding: 1rem 1.5rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center;
            background: rgba(255,255,255,0.02); transition: background 0.2s; font-weight: 600; flex-wrap: wrap; gap: 10px;
        }
        .accordion-header:hover { background: rgba(255,255,255,0.05); }
        .accordion-header.active { border-bottom: 1px solid var(--border-color); color: var(--accent-cyan); }
        .accordion-content { padding: 1.5rem; display: none; overflow: visible; }
        .accordion-content.active { display: block; animation: fadeIn 0.3s ease; }
        .accordion-icon { transition: transform 0.3s; }
        .accordion-header.active .accordion-icon { transform: rotate(180deg); }

        .checklist-item {
            display: flex; align-items: center; gap: 12px; padding: 0.75rem;
            border-bottom: 1px solid var(--border-color); font-size: 0.9rem;
            color: var(--text-secondary); cursor: pointer; transition: background 0.15s;
            border-radius: 8px; word-break: break-word;
        }
        .checklist-item:hover { background: rgba(255,255,255,0.03); }
        .checklist-item input[type="checkbox"] { width: 20px; height: 20px; accent-color: var(--accent-cyan); cursor: pointer; flex-shrink: 0; }
        .checklist-item.checked span { text-decoration: line-through; opacity: 0.6; }

        .plan-maestro-layout { display: grid; grid-template-columns: 350px 1fr; gap: 1.5rem; align-items: start; }
        .lista-actividades { display: flex; flex-direction: column; gap: 0.75rem; }

        .item-actividad {
            background: var(--bg-card); border: 1px solid var(--border-color);
            border-radius: 12px; padding: 1rem; cursor: pointer;
            transition: all 0.2s; border-left: 4px solid transparent;
        }
        .item-actividad:hover { background: var(--bg-card-hover); border-color: var(--accent-cyan); }
        .item-actividad.active { background: rgba(6, 182, 212, 0.1); border-left-color: var(--accent-cyan); border-color: var(--accent-cyan); }
        .item-actividad h4 { font-size: 0.95rem; margin-bottom: 0.25rem; color: var(--text-primary); }
        .item-actividad p { font-size: 0.75rem; color: var(--text-secondary); display: flex; gap: 10px; flex-wrap: wrap; }
        .item-actividad i { color: var(--accent-cyan); width: 16px; text-align: center; }

        .detalle-actividad {
            background: var(--bg-card); border: 1px solid var(--border-color);
            border-radius: 12px; padding: 2rem; min-height: 400px;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            text-align: center; color: var(--text-secondary); overflow-wrap: break-word; min-width: 0;
        }
        .detalle-actividad.visible { display: block; text-align: left; }
        .detalle-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 2px solid var(--accent-cyan); flex-wrap: wrap; gap: 10px; }
        .detalle-header h2 { font-size: 1.4rem; color: var(--text-primary); margin-bottom: 0.5rem; word-break: break-word; }
        .detalle-meta { display: flex; gap: 15px; font-size: 0.85rem; flex-wrap: wrap; }
        .detalle-meta span { display: flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.05); padding: 4px 10px; border-radius: 6px; }

        .seccion-detalle { margin-bottom: 1.5rem; }
        .seccion-detalle h3 { font-size: 1.05rem; color: var(--accent-cyan); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 8px; }

        .lista-requerimientos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .lista-requerimientos ul { list-style: none; background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 8px; border-left: 3px solid var(--accent-emerald); }
        .lista-requerimientos ul.amber { border-left-color: var(--accent-amber); }
        .lista-requerimientos ul.purple { border-left-color: var(--accent-purple); }
        .lista-requerimientos li { font-size: 0.85rem; padding: 0.4rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; gap: 8px; align-items: flex-start; color: var(--text-secondary); word-wrap: break-word; }
        .lista-requerimientos li:last-child { border-bottom: none; }
        .lista-requerimientos li i { color: var(--accent-cyan); margin-top: 3px; flex-shrink: 0; }

        .paso-lista { list-style: none; counter-reset: paso-counter; }
        .paso-lista li { position: relative; padding: 0.75rem 0 0.75rem 2.5rem; font-size: 0.9rem; border-bottom: 1px solid rgba(255,255,255,0.05); counter-increment: paso-counter; color: var(--text-secondary); word-wrap: break-word; }
        .paso-lista li::before { content: counter(paso-counter); position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 24px; height: 24px; background: var(--accent-cyan); color: #0b0f19; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; }

        .cronograma-wrapper { overflow-x: auto; padding-bottom: 1rem; width: 100%; max-width: 100%; border-radius: 8px; border: 1px solid var(--border-color); }
        .cronograma-grid { display: grid; grid-template-columns: 220px repeat(12, 1fr); gap: 6px; font-size: 0.8rem; min-width: 900px; padding: 10px; }
        .cronograma-cell { padding: 0.6rem 0.4rem; text-align: center; background: rgba(255,255,255,0.02); border-radius: 6px; color: var(--text-secondary); cursor: pointer; transition: all 0.2s; border: 1px solid transparent; }
        .cronograma-cell.header { background: rgba(6, 182, 212, 0.15); color: var(--accent-cyan); font-weight: 700; cursor: default; }
        .cronograma-cell.header:hover { border-color: transparent; }
        .cronograma-cell.activo { background: var(--accent-cyan); color: #0b0f19; font-weight: 700; box-shadow: 0 0 10px rgba(6,182,212,0.4); }
        .cronograma-cell.activo-amber { background: var(--accent-amber); color: #0b0f19; font-weight: 700; box-shadow: 0 0 10px rgba(245,158,11,0.4); }
        .cronograma-cell.activo-emerald { background: var(--accent-emerald); color: #0b0f19; font-weight: 700; box-shadow: 0 0 10px rgba(16,185,129,0.4); }
        .cronograma-cell.activo-purple { background: var(--accent-purple); color: #fff; font-weight: 700; box-shadow: 0 0 10px rgba(168,85,247,0.4); }
        .cronograma-cell:hover:not(.header) { border-color: var(--accent-cyan); color: var(--text-primary); }

        #detalleCronograma { margin-top: 1.5rem; padding: 1.5rem; background: var(--bg-card); border: 1px solid var(--accent-cyan); border-radius: 12px; display: none; animation: fadeIn 0.3s ease; }
        #detalleCronograma.visible { display: block; }
        .detalle-header-modal { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-color); flex-wrap: wrap; gap: 10px; }
        .detalle-header-modal h3 { font-size: 1.1rem; color: var(--accent-cyan); word-break: break-word; }
        .detalle-close { background: transparent; border: none; color: var(--text-secondary); cursor: pointer; font-size: 1.2rem; }
        .detalle-close:hover { color: var(--accent-red); }

        /* ===== ESTILOS DE HOJA TAMAÑO CARTA (ISO 9001) ===== */
        .hoja-carta-container { width: 100%; overflow-x: auto; padding: 1rem 0; }
        .hoja-carta {
            background-color: #ffffff; color: #000000; width: 21.59cm; min-height: 27.94cm;
            padding: 1.5cm; margin: 0 auto 2rem auto; box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            position: relative; font-family: Arial, Helvetica, sans-serif; box-sizing: border-box;
            page-break-after: always; display: flex; flex-direction: column;
        }

        .carta-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 15px; }
        .carta-header .logo { display: flex; align-items: center; gap: 10px; }
        .carta-header .logo-icon { width: 40px; height: 40px; background: #333; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: bold; }
        .carta-header h2 { font-size: 16px; margin: 0; text-transform: uppercase; }
        .carta-header p { margin: 2px 0 0 0; font-size: 12px; }

        .carta-documento-info { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; font-size: 12px; margin-bottom: 15px; border: 1px solid #000; padding: 10px; }
        .carta-documento-info div { display: flex; flex-direction: column; }
        .carta-documento-info strong { font-size: 10px; color: #555; text-transform: uppercase; }

        .carta-tabla-wrapper { width: 100%; overflow-x: auto; margin-bottom: 15px; }
        .carta-tabla { width: 100%; border-collapse: collapse; font-size: 11px; }
        .carta-tabla th, .carta-tabla td { border: 1px solid #000; padding: 8px; text-align: left; vertical-align: top; }
        .carta-tabla th { background-color: #f0f0f0; font-weight: bold; text-align: center; font-size: 11px; }
        .carta-tabla ul { margin: 0; padding-left: 15px; }
        .carta-tabla ol { margin: 0; padding-left: 15px; }

        .carta-firmas { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-top: auto; padding-top: 30px; font-size: 11px; text-align: center; }
        .carta-firma-box { border-top: 1px solid #000; padding-top: 5px; }
        .carta-firma-box strong { display: block; }
        .carta-firma-box span { font-size: 10px; color: #555; }

        .ot-form-control { width: 100%; padding: 0.7rem; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-dark); color: white; font-family: 'Inter', sans-serif; }
        .ot-print-btn { background: var(--accent-purple); color: white; padding: 0.75rem 1.5rem; border-radius: 8px; border: none; cursor: pointer; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; margin-top: 1rem; margin-bottom: 1rem; }

        .btn-maximize { position: absolute; top: 10px; right: 10px; background: #333; color: white; border: none; border-radius: 4px; padding: 5px 10px; font-size: 12px; cursor: pointer; z-index: 10; display: flex; align-items: center; gap: 5px; }
        .btn-maximize:hover { background: #555; }

        /* ===== MODAL PANTALLA COMPLETA ===== */
        .modal-ot-fullscreen { display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: #111827; z-index: 9999; flex-direction: column; }
        .modal-ot-fullscreen.active { display: flex; }
        .modal-ot-header { background: #1f2937; padding: 10px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #374151; flex-shrink: 0; }
        .modal-ot-header h2 { font-size: 1.1rem; color: #f1f5f9; margin: 0; font-family: 'Inter', sans-serif; }
        .btn-cerrar-modal { background: #ef4444; color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 6px; font-size: 14px; }
        .btn-cerrar-modal:hover { background: #dc2626; }
        .modal-ot-body { flex: 1; overflow-y: auto; overflow-x: auto; padding: 20px; display: flex; justify-content: center; }
        .modal-ot-content { background: #ffffff; color: #000000; width: 100%; max-width: 21.59cm; min-height: 27.94cm; padding: 1.5cm; box-sizing: border-box; font-family: Arial, Helvetica, sans-serif; box-shadow: 0 0 20px rgba(0,0,0,0.5); display: flex; flex-direction: column; }

        @media (max-width: 800px) {
            .modal-ot-body { padding: 0; }
            .modal-ot-content { max-width: 100%; padding: 15px; min-height: 100vh; box-shadow: none; }
            .carta-tabla th, .carta-tabla td { padding: 4px; font-size: 10px; }
            .carta-tabla { min-width: 600px; }
        }

        @media print {
            body { background: white; color: black; }
            .app-header, .nav-tabs, .main-container > .card > .card-header, .ot-form-control, .btn-primary, .alert-box.info, .ot-print-btn, .alert-box.success, .no-print, .btn-maximize, .modal-ot-fullscreen, .modal-ot-back { display: none !important; }
            .main-container { padding: 0; margin: 0; max-width: 100%; }
            #contenedor-ots { padding: 0; background: transparent; border: none; }
            .hoja-carta-container { overflow: visible; padding: 0; }
            .hoja-carta { box-shadow: none; margin: 0; width: 100%; min-height: 100vh; border: none; page-break-after: always; }
            .carta-tabla tr { page-break-inside: avoid; }
            @page { size: letter; margin: 0; }
        }

        @media (max-width: 1000px) {
            .plan-maestro-layout { grid-template-columns: 1fr; }
            .lista-requerimientos { grid-template-columns: 1fr; }
        }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-dark); }
        ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--accent-cyan); }
    </style>
</head>
<body>

    <header class="app-header">
        <div class="logo-area">
            <div class="logo-icon"><i class="fa-solid fa-gears"></i></div>
            <div class="logo-text">
                <h1>Gestión de Mantenimiento Integral</h1>
                <span>Inyección, Soplado y Auxiliares (Chiller, Compresor, Planta)</span>
            </div>
        </div>
        <nav class="nav-tabs" id="navTabs">
            <button class="nav-btn active" data-tab="dashboard"><i class="fa-solid fa-chart-pie"></i> Dashboard</button>
            <button class="nav-btn" data-tab="planes"><i class="fa-solid fa-list-check"></i> Planes</button>
            <button class="nav-btn" data-tab="interactivo"><i class="fa-solid fa-laptop-code"></i> Fichas Técnicas</button>
            <button class="nav-btn" data-tab="ordenes"><i class="fa-solid fa-file-invoice"></i> Órdenes de Trabajo</button>
            <button class="nav-btn" data-tab="montaje"><i class="fa-solid fa-screwdriver-wrench"></i> Montaje</button>
            <button class="nav-btn" data-tab="mantenimiento-moldes"><i class="fa-solid fa-toolbox"></i> Moldes</button>
            <button class="nav-btn" data-tab="recursos"><i class="fa-solid fa-boxes-stacked"></i> Recursos</button>
